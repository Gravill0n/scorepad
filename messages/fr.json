    {
      "declarations": [
        "input count",
        "local countPlural = count: plural"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{count} partie n'existe que sur ce téléphone. Le fichier JSON est la seule sauvegarde.",
        "countPlural=*": "{count} parties n'existent que sur ce téléphone. Le fichier JSON est la seule sauvegarde."
      }
    }
