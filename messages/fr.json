    {
      "declarations": [
        "input imported",
        "local importedPlural = imported: plural",
        "input skipped",
        "local skippedPlural = skipped: plural"
      ],
      "selectors": [
        "importedPlural",
        "skippedPlural"
      ],
      "match": {
        "importedPlural=one,skippedPlural=one": "{imported} restaurée, {skipped} déjà présente",
        "importedPlural=one,skippedPlural=*": "{imported} restaurée, {skipped} déjà présentes",
        "importedPlural=*,skippedPlural=one": "{imported} restaurées, {skipped} déjà présente",
